# The default demo (npm run demo) needs NONE of these: it runs on a local sandbox.
# They are only for the optional testnet path (README, "Run on testnet").

# A testnet account with about 15 NEAR, used only to create the demo accounts.
NEAR_FUNDER_ID=
NEAR_FUNDER_KEY=

# Optional overrides
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# INDEXER_URL=https://api-testnet.nearblocks.io
# NETWORK=testnet
# VAULT_ID=shield-vault.<funder>.testnet
# PORT=8787
